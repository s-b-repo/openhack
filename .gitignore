# Vendored third-party repositories — all tracked, each with an idempotent
# bootstrap.sh that builds a self-contained artifact inside its directory
# (see vendor/README.md). Source is tracked; build artifacts are not.
vendor/*
!vendor/lattice
!vendor/subnext
!vendor/mini-swe-agent
!vendor/gpt-researcher
!vendor/deepagents
!vendor/langgraph
!vendor/graphbit
!vendor/temporal

# lattice — structural code-audit engine (powers /codeaudit)
vendor/lattice/.venv/
vendor/lattice/**/__pycache__/
vendor/lattice/**/*.pyc
vendor/lattice/*.egg-info/
vendor/lattice/src/*.egg-info/

# subnext — Dynamic Context Runtime reference implementation (dcr)
vendor/subnext/bin/
vendor/subnext/target/

# python-venv sidecars (mini-swe-agent, gpt-researcher, deepagents, langgraph)
vendor/*/.venv/
vendor/**/__pycache__/
vendor/**/*.pyc
vendor/**/*.egg-info/
vendor/**/dist/
vendor/**/.pytest_cache/

# graphbit / temporal — rust + go build output
vendor/graphbit/target/
vendor/temporal/bin/

# Local dev files
openhack-dev
UPCOMING_CHANGELOG.md
logs/
*.bun-build
tsconfig.tsbuildinfo

# OpenHack per-engagement runtime state — keep only the config template, the
# agent/command/skill definitions, and dev tooling; never commit findings, logs,
# secrets, ROE, or scope data.
.openhack/*
!.openhack/openhack.jsonc
!.openhack/agents/
!.openhack/agent/
!.openhack/command/
!.openhack/skills/
!.openhack/glossary/
!.openhack/themes/
!.openhack/plugins/
!.openhack/tool/
!.openhack/tui.json
!.openhack/env.d.ts
