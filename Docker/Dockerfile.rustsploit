FROM rust:1.85-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config libssl-dev libdbus-1-dev cmake \
    git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN git clone --depth 1 https://github.com/s-b-repo/rustsploit.git /app

RUN cargo build --release

USER root

ENTRYPOINT ["./target/release/rustsploit", "--mcp"]
