FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl ca-certificates \
    nmap nuclei sqlmap gobuster ffuf hydra john hashcat \
    amass subfinder dnsenum dirsearch nikto wpscan whatweb dalfox \
    netcat-openbsd openssh-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/hexstrike-ai
RUN git clone --depth 1 https://github.com/0x4m4/hexstrike-ai.git /opt/hexstrike-ai

RUN python3 -m venv /opt/hexstrike-env
ENV PATH="/opt/hexstrike-env/bin:$PATH"
RUN pip install --no-cache-dir -r requirements.txt

EXPOSE 8888

CMD ["python3", "hexstrike_server.py", "--port", "8888"]
